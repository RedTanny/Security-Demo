{
  "permissions": {
    "allow": [
      "Bash(python src/app.py)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pytest tests/test_webhooks.py)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "WebFetch(domain:docs.stripe.com)",
      "mcp__internal-docs__search"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
